extends: default
rules:
  document-start: disable
  line-length:
    max: 200
    allow-non-breakable-words: true
  truthy:
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  indentation:
    spaces: 2
    indent-sequences: consistent
# Ignore everything we don't own. Our YAMLs live under .github/workflows/
# and are explicitly re-included below.
ignore: |
  gradle/
  .gradle/
  build/
  k8s/
  .github/dependabot.yml
  .github/actions/
  values.yaml
  kind-config.yaml
  launchers/
  extensions/
  tests/
  config/
  Requests/
